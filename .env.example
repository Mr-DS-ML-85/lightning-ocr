# ⚡ lightning-ocr — Environment Configuration
# Copy this file: cp .env.example .env
# Then edit values for your hardware and setup.
# All variables are optional — defaults shown below are production-safe.

# ═══════════════════════════════════════════════════════════════════════════════
# CORE SERVER
# ═══════════════════════════════════════════════════════════════════════════════

# Public base URL — used in MCP discovery manifest
PUBLIC_URL=http://localhost:8000

# ── GLM-OCR backend (llama.cpp OpenAI-compatible server) ─────────────────────
GLM_OCR_BASE_URL=http://localhost:8080/v1
GLM_OCR_API_KEY=sk-no-key-required
GLM_OCR_MODEL=GLM-OCR

# ── DeepSeek-OCR-WebUI backend (optional) ────────────────────────────────────
# Enable with: docker compose --profile deepseek up
DEEPSEEK_OCR_BASE_URL=http://deepseek-webui:8000
DEEPSEEK_OCR_API_KEY=
DEEPSEEK_OCR_MODEL=

# ── API security ─────────────────────────────────────────────────────────────
# Leave empty for open/development mode (no auth required)
# Set to a strong secret for production
API_KEY=
ADMIN_KEY=

# ── MCP server ───────────────────────────────────────────────────────────────
MCP_ENABLED=true

# ═══════════════════════════════════════════════════════════════════════════════
# HARDWARE ACCELERATION
# ═══════════════════════════════════════════════════════════════════════════════

# Acceleration mode hint passed to UI badge and llama.cpp docker service
# Values: auto | cuda | sycl | vulkan | cpu
ACCEL_MODE=auto

# GPU layer offload for llama.cpp
# 0        = pure CPU (use on any machine, required for 4 GB RAM)
# 99 / -1  = all layers to GPU (RTX series, Arc, M-series)
# 20       = partial offload — 20 layers GPU, rest CPU (useful when VRAM < model size)
# auto     = let llama.cpp decide based on available VRAM
N_GPU_LAYERS=auto

# Context window size
# 1024 = minimum, safe on 4 GB RAM
# 2048 = good balance on 6–8 GB RAM
# 4096 = default, recommended for 16 GB+ RAM
# 8192 = large context, requires 24 GB+ RAM or VRAM
CTX_SIZE=4096

# CPU thread count (used when N_GPU_LAYERS=0 or for non-offloaded layers)
# Set to number of physical CPU cores (not hyperthreads) for best results
N_THREADS=4

# Flash attention — improves performance on CUDA/Vulkan/Metal
# Disable for pure CPU builds (Sandy Bridge and older do not support it)
# Values: true | false
FLASH_ATTN=true

# Lock model in RAM to prevent swapping — requires free RAM >= model size
# Use on systems with 16+ GB RAM and stable workloads
# Do NOT use on 4 GB RAM systems
MLOCK=false

# KV cache quantisation — reduces memory without large quality loss
# f16   = full precision (most memory, best quality)
# q8_0  = 8-bit quantised (recommended — half the memory, near-identical quality)
# q4_0  = 4-bit quantised (lowest memory, some quality loss)
CACHE_TYPE_K=q8_0
CACHE_TYPE_V=q8_0

# ═══════════════════════════════════════════════════════════════════════════════
# FALLBACK OCR ENGINES
# ═══════════════════════════════════════════════════════════════════════════════

# Tesseract — always-local fallback, zero model RAM, instant startup
# Disable only if tesseract-ocr is not installed and you are sure AI backends work
TESSERACT_ENABLED=true

# EasyOCR — heavier local fallback, ~1 GB RAM for model weights
# Good for multi-language documents
# Install: pip install easyocr
EASYOCR_ENABLED=false

# EasyOCR languages — comma-separated ISO 639-1 codes
# Examples: en | en,fr,de | en,zh | en,ja,ko
EASYOCR_LANGS=en

# ═══════════════════════════════════════════════════════════════════════════════
# PERSISTENT STORAGE
# ═══════════════════════════════════════════════════════════════════════════════

# SQLite database path for job history
# Docker: maps to ./data/ host directory via volume
# Manual: use any writable path e.g. ./data/lightning_ocr.db
DB_PATH=/data/lightning_ocr.db

# ═══════════════════════════════════════════════════════════════════════════════
# BACKEND OVERRIDE (ADVANCED)
# ═══════════════════════════════════════════════════════════════════════════════

# JSON array to fully replace the default backend list.
# Leave empty to use the default (GLM-OCR + Tesseract + optional DeepSeek/EasyOCR).
#
# Example (paste on one line, no linebreaks):
# OCR_BACKENDS=[{"id":"glm-ocr","label":"GLM-OCR","kind":"openai_compatible","base_url":"http://localhost:8080/v1","model":"GLM-OCR","priority":0},{"id":"tesseract","label":"Tesseract","kind":"tesseract","priority":10}]
OCR_BACKENDS=

# ═══════════════════════════════════════════════════════════════════════════════
# AGENTS
# ═══════════════════════════════════════════════════════════════════════════════

# URL that agent clients use to reach the lightning-ocr MCP server
# Change if running on a remote host
LIGHTNING_OCR_MCP_URL=http://localhost:8000/mcp

# API key agents use when calling the MCP server
# Must match API_KEY above if API_KEY is set
LIGHTNING_OCR_API_KEY=

# ── Hermes agent (requires llama.cpp server with a Hermes-family model) ───────
# Download: huggingface-cli download NousResearch/Hermes-3-Llama-3.1-8B-GGUF
# Start: llama-server -hf NousResearch/Hermes-3-Llama-3.1-8B-GGUF --port 8080
HERMES_LLM_URL=http://localhost:8080/v1
HERMES_LLM_KEY=sk-no-key-required
HERMES_MODEL=hermes-3

# ═══════════════════════════════════════════════════════════════════════════════
# LLAMA.CPP SERVER (env-based config — used by Docker services)
# These map to LLAMA_ARG_* env vars read by llama-server directly.
# Only needed when running llama-server via Docker env (not CLI flags).
# ═══════════════════════════════════════════════════════════════════════════════

# These are passed through docker-compose.yml to the llama container:
# LLAMA_ARG_CTX_SIZE=${CTX_SIZE}
# LLAMA_ARG_N_GPU_LAYERS=${N_GPU_LAYERS}
# LLAMA_ARG_CACHE_TYPE_K=${CACHE_TYPE_K}
# LLAMA_ARG_CACHE_TYPE_V=${CACHE_TYPE_V}
# LLAMA_ARG_THREADS=${N_THREADS}

# ═══════════════════════════════════════════════════════════════════════════════
# PRESET PROFILES (uncomment one block at a time)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Profile: Intel Core i5 2nd gen / 4 GB RAM / no GPU ───────────────────────
# ACCEL_MODE=cpu
# N_GPU_LAYERS=0
# CTX_SIZE=1024
# N_THREADS=4
# FLASH_ATTN=false
# MLOCK=false
# CACHE_TYPE_K=q8_0
# CACHE_TYPE_V=q8_0
# TESSERACT_ENABLED=true
# EASYOCR_ENABLED=false

# ── Profile: Mid-range CPU / 8–16 GB RAM / no GPU ────────────────────────────
# ACCEL_MODE=cpu
# N_GPU_LAYERS=0
# CTX_SIZE=4096
# N_THREADS=8
# FLASH_ATTN=false
# MLOCK=true
# CACHE_TYPE_K=q8_0
# CACHE_TYPE_V=q8_0

# ── Profile: NVIDIA GPU / 8 GB VRAM (GTX 1080, RTX 2080, etc.) ───────────────
# ACCEL_MODE=cuda
# N_GPU_LAYERS=20
# CTX_SIZE=4096
# FLASH_ATTN=true
# MLOCK=false
# CACHE_TYPE_K=q8_0
# CACHE_TYPE_V=q8_0

# ── Profile: NVIDIA GPU / 12–16 GB VRAM (RTX 3080, 4070, etc.) ───────────────
# ACCEL_MODE=cuda
# N_GPU_LAYERS=99
# CTX_SIZE=8192
# FLASH_ATTN=true
# MLOCK=false
# CACHE_TYPE_K=q8_0
# CACHE_TYPE_V=q8_0

# ── Profile: NVIDIA GPU / 24 GB VRAM (RTX 3090, 4090, etc.) ─────────────────
# ACCEL_MODE=cuda
# N_GPU_LAYERS=99
# CTX_SIZE=16384
# FLASH_ATTN=true
# MLOCK=false
# CACHE_TYPE_K=f16
# CACHE_TYPE_V=f16

# ── Profile: Intel Arc / UHD 730+ (SYCL/Vulkan) ──────────────────────────────
# ACCEL_MODE=sycl
# N_GPU_LAYERS=auto
# CTX_SIZE=4096
# FLASH_ATTN=true
# MLOCK=false
# CACHE_TYPE_K=q8_0
# CACHE_TYPE_V=q8_0

# ── Profile: Apple Silicon (M1/M2/M3/M4) ─────────────────────────────────────
# ACCEL_MODE=auto
# N_GPU_LAYERS=99
# CTX_SIZE=8192
# FLASH_ATTN=true
# MLOCK=false
# CACHE_TYPE_K=q8_0
# CACHE_TYPE_V=q8_0